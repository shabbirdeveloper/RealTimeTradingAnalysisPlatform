# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). Never commit .env.local.
#
# NEXT_PUBLIC_* values are safe to ship to the browser by design (the anon
# key only ever grants what this schema's RLS policies allow — see
# supabase/migrations/20260829000008_rls_policies.sql). The service role key
# is NOT listed here on purpose: it bypasses RLS entirely and must only ever
# live in the backend (apps/api's environment), never in this Next.js app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# Mirrors apps/api's own PUBLIC_MARKET_COLLECTOR_ENABLED. Set them together:
# the web app cannot observe the scheduler, so this is how the dashboard
# knows a stale card means "switched off" rather than "engine crashed".
# Server-side only — deliberately NOT NEXT_PUBLIC.
PUBLIC_MARKET_COLLECTOR_ENABLED=false
