# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Twelve Data (https://twelvedata.com/pricing) -- leave unset to run
# against the built-in demo provider instead (no real data, no cost, no
# key required). Free tier: 800 requests/day, 8 credits/minute.
TWELVE_DATA_API_KEY=

# Supabase -- use the SERVICE ROLE key here, never the anon key. This
# process writes directly to the database, bypassing RLS by design (RLS
# on candles/system_health is written for what the browser may touch, not
# this trusted backend process). Find it in Supabase Dashboard -> Settings
# -> API -> service_role. NEVER put this key in apps/web or in Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Seconds between polls, per full asset cycle (every open asset is polled
# back-to-back each tick, so this is the interval between CYCLES, not
# between individual asset calls).
#
# With 5 assets -- 3 forex/gold (~17h/day) plus 2 crypto (24/7) -- the
# request budget is roughly:
#     300s -> ~1,198/day   OVER the Twelve Data free tier (800/day)
#     450s -> ~799/day     right at the limit
#     600s -> ~599/day     comfortable (this default)
# Lower it only if your plan allows more. See README.md.
POLL_INTERVAL_SECONDS=600

# How many recent M5 bars to request per poll. Larger than the bare
# minimum on purpose so a missed poll (restart, network hiccup) self-heals
# on the next successful call instead of leaving a permanent gap.
POLL_OUTPUTSIZE=30

# Shared secret required by this service's admin endpoints (POST
# /admin/backtests). Generate any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left blank, admin endpoints refuse to run rather than defaulting
# open. This is a minimum bar, not real auth -- put a proper auth layer
# in front of this service before exposing it to the internet.
ADMIN_API_KEY=

# --- Telegram alerts (optional) ---------------------------------------------
# The engine is built to stay quiet, so a signal is rare -- and a rare signal
# you don't see is worth nothing. Set both to get new CALL/PUT signals pushed
# to your phone. Leave unset and signals are still recorded, just not pushed.
#
# Bot token:  message @BotFather on Telegram -> /newbot
# Chat id:    message your new bot once, then open
#             https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#             and read result[0].message.chat.id
#
# Only NEW directional signals alert. NO_TRADE, rejected setups, and a
# standing signal re-confirmed on later cycles never do -- an alert that
# repeats is one you learn to ignore.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hour (UTC) for the daily "collector is alive" report. This engine
# rejects most setups by design, so a quiet channel is the expected
# state -- but a working silent system and a dead one look identical,
# and the instinctive fix (lower the quality bar until messages appear)
# is the wrong one. One report a day removes the ambiguity.
# 0 = midnight UTC. Set to -1 to switch it off.
HEARTBEAT_HOUR_UTC=0
